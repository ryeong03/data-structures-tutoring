# Used by CDK at synth/deploy time. Never commit real values.
TUTOR_EMAIL=tutor@example.com
TUTOR_DISPLAY_NAME=튜터 이름
GOOGLE_CLIENT_ID=google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT:secret:tutoring/google-oauth-XXXX
TELEGRAM_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:ACCOUNT:secret:tutoring/telegram-XXXX
COGNITO_DOMAIN_PREFIX=unique-tutoring-prefix
BUDGET_EMAIL=tutor@example.com
MATERIALS_DIR=/absolute/path/to/private/pdfs
# First deployment: omit APP_URL. After CDK prints SiteUrl, set it and deploy again.
# APP_URL=https://xxxxxxxx.cloudfront.net
