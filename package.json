{
  "name": "data-structures-tutoring",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "VITE_DEMO=1 vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.web.json && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "synth": "npm run build && cdk synth",
    "deploy": "node scripts/check-deploy.mjs && npm run build && cdk deploy --require-approval never --outputs-file cdk-outputs.json && node scripts/import-local-data.mjs",
    "import:local": "node scripts/import-local-data.mjs",
    "telegram:chat-id": "node scripts/telegram-chat-id.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1000.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@aws-sdk/lib-dynamodb": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "aws-amplify": "^6.17.0",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "aws-cdk": "^2.1030.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
